@model global::Controller.Models.AdminDocumentListViewModel

@{
    ViewData["Title"] = "Manage Documents";
}

<div class="row">
    <div class="col-md-3">
        @await Html.PartialAsync("_AdminNav")
    </div>

    <div class="col-md-9 admin-content">

        <h2>Manage Documents</h2>

        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <input name="query" value="@Model.Query" class="form-control" placeholder="Search by title" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary">Search</button>
            </div>
        </form>

        <div class="admin-table-surface">
            <div class="admin-card-table">
                <table class="table table-striped">
            <thead>
                <tr>
                    <th>
                        <a asp-action="Documents" asp-route-sortBy="title"
                               asp-route-sortDir="@(Model.SortBy == "title" && Model.SortDir == "asc" ? "desc" : "asc")"
                               asp-route-query="@Model.Query" asp-route-page="1">Title @(Model.SortBy=="title" ?
                                                        (Model.SortDir == "asc" ? "▲" : "▼") : "")</a>
                        </th>
                        <th>
                            <a asp-action="Documents" asp-route-sortBy="owner"
                                   asp-route-sortDir="@(Model.SortBy == "owner" && Model.SortDir == "asc" ? "desc" : "asc")"
                                   asp-route-query="@Model.Query" asp-route-page="1">Owner @(Model.SortBy=="owner" ?
                                                            (Model.SortDir == "asc" ? "▲" : "▼") : "")</a>
                            </th>
                            <th>
                                <a asp-action="Documents" asp-route-sortBy="updated"
                                       asp-route-sortDir="@(Model.SortBy == "updated" && Model.SortDir == "asc" ? "desc" : "asc")"
                                       asp-route-query="@Model.Query" asp-route-page="1">Updated @(Model.SortBy=="updated" ?
                                                                (Model.SortDir == "asc" ? "▲" : "▼") : "")</a>
                                </th>
                                <th style="width:160px">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Documents)
                            {
                                <tr>
                                    <td>@d.Title</td>
                                    <td>@d.OwnerEmail</td>
                                    <td>@d.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-primary" asp-action="EditDocument"
                                          asp-route-id="@d.Id">Edit</a>
                                        <form asp-action="DeleteDocument" method="post" class="d-inline ms-1"
                                             onsubmit="return confirm('Delete this document?');">
                                            @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button class="btn btn-sm btn-outline-danger">Delete</button>
</form>
                                    </td>
                                </tr>
        
        
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-3 d-flex align-items-center justify-content-between">
                        <div>
                            <span class="small">Page @Model.CurrentPage of @Model.TotalPages</span>
                        </div>
                        <nav>
                            <ul class="pagination mb-0">
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" asp-action="Documents" asp-route-page="@(Model.CurrentPage - 1)"
                                      asp-route-pageSize="@Model.PageSize" asp-route-query="@Model.Query"
                                      asp-route-sortBy="@Model.SortBy" asp-route-sortDir="@Model.SortDir">Previous</a>
                                </li>
                                @for(int i = 1; i <= Model.TotalPages; i++)
                    {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" :"")">
                                        <a class="page-link" asp-action="Documents" asp-route-page="@i"
                                         asp-route-pageSize="@Model.PageSize" asp-route-query="@Model.Query"
                                         asp-route-sortBy="@Model.SortBy" asp-route-sortDir="@Model.SortDir">@i</a>
                                    </li>
                   
                                }
                                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" :"")">
                                    <a class="page-link" asp-action="Documents" asp-route-page="@(Model.CurrentPage + 1)"
                                     asp-route-pageSize="@Model.PageSize" asp-route-query="@Model.Query"
                                     asp-route-sortBy="@Model.SortBy" asp-route-sortDir="@Model.SortDir">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>

                </div>
            </div>
